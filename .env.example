# GPT-4o — frame analysis + work instructions
# Copy the BASE endpoint from Azure Portal → Keys and Endpoint (not /deployments/... URL)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_KEY=your-gpt4o-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Whisper — audio transcription (separate resource)
AZURE_OPENAI_WHISPER_ENDPOINT=https://your-whisper-resource.services.ai.azure.com
AZURE_OPENAI_WHISPER_KEY=your-whisper-key
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# Optional (not used when Whisper is configured)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2
AZURE_SPEECH_LANGUAGE=en-US

# Azure Blob Storage — job artifacts and video clips
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_CONTAINER_NAME=document-videos
AZURE_STORAGE_JOB_PREFIX=jobs
AZURE_BLOB_SAS_EXPIRY_HOURS=24

# API server — local dev
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=false

# Production (Azure App Service / Container Apps set PORT automatically)
# PORT=8000
# CORS_ORIGINS=https://your-ui.azurestaticapps.net,https://app.yourcompany.com

# Local dev — allow all origins
CORS_ORIGINS=*

# Pipeline defaults (1 frame per second of video; tune workers for Azure memory)
FRAME_INTERVAL_SECONDS=1.0
DEFAULT_VISION_WORKERS=8
DEFAULT_ANALYZE_EVERY=1
